# Copy this file to .env and fill in real values. Never commit .env.
# The server is started with `node --env-file=.env ...` (see package.json),
# so anything set here becomes available via process.env.

# --- Traqo FASTag live-tracking API ---
TRACK_API_USERNAME=
TRACK_API_PASSWORD=
TRACK_API_URL=https://dashboard.traqo.in/api/v1/fastag/fetch_live_locations/

# --- Reverse geocoding (OpenStreetMap Nominatim) ---
# Optional but recommended by Nominatim's usage policy so they can contact
# you if your usage needs attention, instead of just blocking your IP.
GEOCODE_CONTACT_EMAIL=tauqeerahmad672@gmail.com
# Optional: customize the User-Agent Nominatim sees (defaults to a generic one)
GEOCODE_USER_AGENT=LorryCare/1.0 (contact: tauqeerahmad672@gmail.com)

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string

# --- Server ---
PORT=4000
